# ---------------------------------------------------------------------------
# Bullseye Webex Calling sidecar — configuration.
#
# Copy to `.env` and fill in. The Webex sections come from Control Hub
# (your Webex admin); the Bullseye Agent section is provided by Armor.
#
# This one file is read by BOTH containers (agent + Asterisk).
# ---------------------------------------------------------------------------


# ───── Bullseye Agent (provided by Armor) ──────────────────────────────────

BULLSEYE_SERVER_URL=https://your-bullseye-server
BULLSEYE_API_KEY=bse_your_api_key_here
TELEPHONY_PROVIDER=webex

# How many test calls the agent will run at once. Keep this at or below
# (number of Webex lines below) x (calls each line may carry). Start low
# and raise it once you have measured your org's per-line limit.
BULLSEYE_MAX_CONCURRENT_CALLS=2

# Optional. Prefix for the two container names (default: "bullseye" ->
# bullseye-agent / bullseye-asterisk). Set if you run several stacks on
# one host.
# BULLSEYE_CONTAINER_NAME=bullseye-webex


# ───── Webex Calling: SIP service (from Control Hub) ───────────────────────
# When you add a Customer Managed Device -> Generic SIP Phone, Control Hub
# shows the SIP domain ("Server") and the Outbound Proxy to register
# through. They are the same for every device in your org.

WEBEX_SIP_DOMAIN=your-org.example.webex.com
WEBEX_OUTBOUND_PROXY=your-org.example.webex.com

# Leave empty so Asterisk uses the _sips._tcp DNS SRV record (what Cisco
# tells third-party devices to do). Set to 5061 only if your DNS blocks
# SRV lookups.
WEBEX_SIP_PORT=


# ───── Webex Calling: lines (one per number you want tested) ──────────────
# Each line = one Generic SIP Phone device in Control Hub, assigned to a
# user or workspace whose *outgoing caller ID* is set to that number.
# Bullseye routes a test on its "from" number to the matching line and
# refuses numbers that are not listed here.
#
# Add WEBEX_LINE_3_..., WEBEX_LINE_4_..., etc. as needed — numbering must
# be consecutive starting at 1.

WEBEX_LINE_1_NUMBER=+15551234567
WEBEX_LINE_1_SIP_USERNAME=
WEBEX_LINE_1_SIP_PASSWORD=

# WEBEX_LINE_2_NUMBER=+15557654321
# WEBEX_LINE_2_SIP_USERNAME=
# WEBEX_LINE_2_SIP_PASSWORD=


# ───── Webex Calling: dialing format (usually leave alone) ─────────────────
# Bullseye sends the destination as +E.164 (e.g. +12223334444), which Webex
# accepts by default. If your location's dial plan needs national or
# prefixed dialing instead, adjust:
#   WEBEX_STRIP_PLUS=yes      -> 12223334444
#   WEBEX_DIAL_PREFIX=9       -> 9+12223334444 (or 912223334444 with strip)
WEBEX_STRIP_PLUS=no
WEBEX_DIAL_PREFIX=


# ───── Network (only if calls connect but have no audio) ───────────────────
# Public IP of this host, if it sits behind NAT and symmetric RTP alone is
# not enough. Leave empty to start.
WEBEX_EXTERNAL_IP=
# Local subnets to exclude from NAT rewriting, e.g. 10.0.0.0/8
WEBEX_LOCAL_NET=

# TLS verification of Webex's SIP proxy. Keep "yes". "no" is for lab
# diagnosis only and is logged loudly.
WEBEX_TLS_VERIFY_SERVER=yes


# ───── Bullseye agent → Asterisk (ARI) connection ──────────────────────────
# These never leave the host; pick any strong password.

ARI_PASSWORD=change-me-to-a-strong-password

# The agent's WebexProvider defaults to the values below; only override if
# you moved Asterisk off this host.
# ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
# ASTERISK_ARI_USERNAME=bullseye
# ASTERISK_ARI_PASSWORD=${ARI_PASSWORD}
# ASTERISK_CONTEXT=bullseye-landing
# ASTERISK_EXTENSION=s
# ASTERISK_DIAL_TIMEOUT=30
