#!/bin/bash
# net-check — run a network diagnostic for the Bullseye agent.
#
# Reads BULLSEYE_SERVER_URL and TELEPHONY_PROVIDER from the environment
# and probes each hop: DNS -> TCP -> TLS -> HTTP. Prints a PASS / FAIL
# for each step so support can pinpoint where things are broken.
#
# Usage (inside the container):
#   net-check
#
# Or from outside (Docker):
#   docker exec bullseye-agent net-check
#
# Or from outside (Kubernetes):
#   kubectl exec -it deployment/bullseye-agent -- net-check

set -u

# Colors — only when stdout is a TTY.
if [ -t 1 ]; then
    GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[0;33m'
    BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'
else
    GREEN=''; RED=''; YELLOW=''; BOLD=''; DIM=''; RESET=''
fi

pass()  { printf "  ${GREEN}PASS${RESET}  %s\n" "$1"; }
fail()  { printf "  ${RED}FAIL${RESET}  %s  ${DIM}(%s)${RESET}\n" "$1" "$2"; }
warn()  { printf "  ${YELLOW}WARN${RESET}  %s  ${DIM}(%s)${RESET}\n" "$1" "$2"; }
skip()  { printf "  ${DIM}SKIP${RESET}  %s  ${DIM}(%s)${RESET}\n" "$1" "$2"; }
head1() { printf "\n${BOLD}%s${RESET}\n" "$1"; }
head2() { printf "\n${BOLD}--- %s ---${RESET}\n" "$1"; }

check_host() {
    # check_host <label> <host> <port>
    local label="$1" host="$2" port="$3"

    if getent hosts "$host" >/dev/null 2>&1; then
        pass "DNS resolves ${label} (${host})"
    else
        fail "DNS lookup failed for ${host}" "check CoreDNS / cluster DNS policy"
        return
    fi

    if nc -z -w 5 "$host" "$port" >/dev/null 2>&1; then
        pass "TCP reachable ${label} (${host}:${port})"
    else
        fail "TCP to ${host}:${port} blocked or reset" "firewall / NetworkPolicy / security group / egress proxy"
        return
    fi

    # Use curl for a real TLS + HTTP check.  --head keeps the response
    # small; --max-time bounds the wait; -sS shows errors but suppresses
    # the progress bar.
    if [ "$port" = "443" ] || [ "$port" = "8089" ]; then
        local scheme="https"
    else
        local scheme="http"
    fi

    local url="${scheme}://${host}"
    if [ "$port" != "443" ] && [ "$port" != "80" ]; then
        url="${scheme}://${host}:${port}"
    fi

    local http_out
    http_out=$(curl -sS --head --max-time 8 -o /dev/null -w '%{http_code} %{ssl_verify_result} %{time_total}' "$url" 2>&1)
    local rc=$?
    if [ $rc -eq 0 ]; then
        local code=${http_out%% *}
        pass "TLS + HTTP ${label} responded (HTTP ${code})"
    else
        # Common curl exit codes we translate to something readable.
        local hint
        case $rc in
            6)  hint="DNS problem" ;;
            7)  hint="TCP connection refused / not reachable" ;;
            28) hint="timeout — likely dropped or intercepted" ;;
            35) hint="TLS handshake failed — possible TLS-inspecting middlebox" ;;
            52) hint="server closed connection with empty reply" ;;
            56) hint="connection reset by peer — firewall / DPI dropping mid-stream" ;;
            *)  hint="curl exit ${rc}" ;;
        esac
        fail "TLS + HTTP ${label} failed" "$hint"
    fi
}

head1 "Bullseye agent net-check"
printf "${DIM}Ran from inside the agent's network namespace.${RESET}\n"

head2 "Environment"
printf "  TELEPHONY_PROVIDER : ${TELEPHONY_PROVIDER:-<unset>}\n"
if [ -n "${BULLSEYE_SERVER_URL:-}" ]; then
    # Redact everything after the scheme + host so this can be pasted safely.
    server_display=$(printf '%s' "$BULLSEYE_SERVER_URL" | awk -F/ '{print $1"//"$3}')
    printf "  BULLSEYE_SERVER_URL: ${server_display}\n"
else
    printf "  BULLSEYE_SERVER_URL: ${YELLOW}<unset>${RESET}\n"
fi

# Show any proxy env vars — these are a common invisible cause of trouble.
proxy_vars=""
for v in HTTP_PROXY HTTPS_PROXY http_proxy https_proxy NO_PROXY no_proxy; do
    val="$(printenv "$v" 2>/dev/null || true)"
    [ -n "$val" ] && proxy_vars="${proxy_vars}  ${v}=${val}\n"
done
if [ -n "$proxy_vars" ]; then
    printf "  ${YELLOW}Proxy env vars set — the container is going through a proxy:${RESET}\n"
    printf "$proxy_vars"
else
    printf "  Proxy env vars     : none\n"
fi

# --- Bullseye server ---
if [ -n "${BULLSEYE_SERVER_URL:-}" ]; then
    head2 "Bullseye server"
    server_host=$(printf '%s' "$BULLSEYE_SERVER_URL" | awk -F/ '{print $3}' | awk -F: '{print $1}')
    check_host "Bullseye server" "$server_host" 443
else
    head2 "Bullseye server"
    skip "Bullseye server check" "BULLSEYE_SERVER_URL not set"
fi

# --- Telephony provider ---
head2 "Telephony provider"
case "${TELEPHONY_PROVIDER:-}" in
    twilio)
        check_host "Twilio REST API"          "api.twilio.com"          443
        check_host "Twilio media (SIP TLS)"   "chunderw-vpc-gll.twilio.com" 443
        ;;
    bandwidth)
        check_host "Bandwidth Voice API"      "voice.bandwidth.com"     443
        check_host "Bandwidth dashboard"      "dashboard.bandwidth.com" 443
        ;;
    telnyx)
        check_host "Telnyx API"               "api.telnyx.com"          443
        ;;
    ringcentral)
        rc_host=$(printf '%s' "${RINGCENTRAL_SERVER_URL:-https://platform.ringcentral.com}" | awk -F/ '{print $3}' | awk -F: '{print $1}')
        check_host "RingCentral platform"     "$rc_host"                443
        ;;
    asterisk)
        if [ -n "${ASTERISK_ARI_URL:-}" ]; then
            ari_host=$(printf '%s' "$ASTERISK_ARI_URL" | awk -F/ '{print $3}' | awk -F: '{print $1}')
            ari_port=$(printf '%s' "$ASTERISK_ARI_URL" | awk -F/ '{print $3}' | awk -F: '{print ($2=="")?"8088":$2}')
            check_host "Asterisk ARI"          "$ari_host"               "$ari_port"
        else
            skip "Asterisk ARI check" "ASTERISK_ARI_URL not set"
        fi
        ;;
    freeswitch)
        if [ -n "${FREESWITCH_HOST:-}" ]; then
            check_host "FreeSWITCH ESL"        "$FREESWITCH_HOST"        "${FREESWITCH_PORT:-8021}"
        else
            skip "FreeSWITCH ESL check" "FREESWITCH_HOST not set"
        fi
        ;;
    proprietary)
        skip "provider check" "proprietary — customer's own network; test it yourself"
        ;;
    *)
        skip "provider check" "TELEPHONY_PROVIDER=${TELEPHONY_PROVIDER:-<unset>} not recognized"
        ;;
esac

printf "\n${BOLD}Done.${RESET}\n"
printf "${DIM}If any check FAILed, share this whole output (it does not include credentials) with your Bullseye contact.${RESET}\n"
